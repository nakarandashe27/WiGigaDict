{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiGigaDict",
  "version": "0.0.1",
  "identifier": "ru.wigigadict.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WiGigaDict",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "WiGigaDict recording status",
        "width": 176,
        "height": 56,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "capabilities": ["main", "overlay"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/wigigadict-asr-sidecar",
      "binaries/wigigadict-asr-worker"
    ],
    "resources": ["catalog.json", "catalog.sig"]
  }
}
